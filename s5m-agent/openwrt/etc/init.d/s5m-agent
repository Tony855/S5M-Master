#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
S5M_HOME="/etc/s5m-agent"
AGENT_BIN="/usr/bin/s5m-agent"
MIHOMO_BIN="/usr/bin/mihomo"
WEB_INDEX="/usr/share/s5m-agent/index.html"

load_config() {
	config_load s5m-agent
	config_get enabled main enabled '1'
	config_get data_dir main data_dir '/etc/s5m-agent'
	S5M_HOME="$data_dir"
}

start_service() {
	load_config
	[ "$enabled" = "1" ] || { logger -t s5m-agent "Disabled by UCI"; return 0; }
	[ -x "$AGENT_BIN" ] || { logger -t s5m-agent "Agent binary missing"; return 1; }
	[ -s "$WEB_INDEX" ] || { logger -t s5m-agent "Agent registration page missing"; return 1; }
	mkdir -p "$S5M_HOME" || return 1
	chmod 0700 "$S5M_HOME"
	if [ ! -s "$S5M_HOME/config.yaml" ]; then
		[ -s /usr/share/s5m-agent/default-config.yaml ] || { logger -t s5m-agent "Default Mihomo config missing"; return 1; }
		cp /usr/share/s5m-agent/default-config.yaml "$S5M_HOME/config.yaml" || return 1
		chmod 0600 "$S5M_HOME/config.yaml"
	fi
	if grep -Eq '^secret:[[:space:]]*"?(__S5M_GENERATED_SECRET__|__S5M_MIHOMO_SECRET__|change-this-secret)"?[[:space:]]*$' "$S5M_HOME/config.yaml"; then
		secret="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d '[:space:]')"
		[ "$(printf '%s' "$secret" | wc -c)" -eq 64 ] || { logger -t s5m-agent "Mihomo secret generation failed"; return 1; }
		sed -i "s|^secret:.*|secret: \"$secret\"|" "$S5M_HOME/config.yaml"
		chmod 0600 "$S5M_HOME/config.yaml"
	fi
	procd_open_instance agent
	procd_set_param command "$AGENT_BIN"
	procd_set_param env MIHOMO_HOME="$S5M_HOME" MIHOMO_BINARY="$MIHOMO_BIN" S5M_WEB_INDEX="$WEB_INDEX"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
service_triggers() {
	procd_add_reload_trigger "s5m-agent"
}
