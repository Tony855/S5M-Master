#!/bin/sh /etc/rc.common
# S5M native OpenWrt services: Mihomo and Agent are supervised independently.
START=95
STOP=10
USE_PROCD=1

S5M_HOME="/etc/s5m-agent"
AGENT_BIN="/usr/bin/s5m-agent"
MIHOMO_BIN="/usr/bin/mihomo"
WEB_INDEX="/usr/share/s5m-agent/index.html"

start_service() {
	[ -x "$AGENT_BIN" ] || {
		logger -t s5m-agent "Agent binary missing: $AGENT_BIN"
		return 1
	}
	[ -x "$MIHOMO_BIN" ] || {
		logger -t s5m-agent "Mihomo binary missing: $MIHOMO_BIN"
		return 1
	}

	mkdir -p "$S5M_HOME" || return 1
	if [ ! -s "$S5M_HOME/config.yaml" ]; then
		[ -s /usr/share/s5m-agent/default-config.yaml ] || {
			logger -t s5m-agent "Default Mihomo config is missing"
			return 1
		}
		cp /usr/share/s5m-agent/default-config.yaml "$S5M_HOME/config.yaml" || return 1
		chmod 0600 "$S5M_HOME/config.yaml"
	fi

	# Start Mihomo first. The API is expected to stay loopback-only.
	procd_open_instance mihomo
	procd_set_param command "$MIHOMO_BIN" -d "$S5M_HOME" -f "$S5M_HOME/config.yaml"
	procd_set_param env MIHOMO_HOME="$S5M_HOME"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance agent
	procd_set_param command "$AGENT_BIN"
	procd_set_param env MIHOMO_HOME="$S5M_HOME" MIHOMO_BINARY="$MIHOMO_BIN" S5M_WEB_INDEX="$WEB_INDEX"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "s5m-agent"
}
